# Credenciais do painel (obrigatórias na Vercel)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
SESSION_SECRET=gere-uma-string-longa-e-aleatoria

# Banco de dados
# Local: SQLite automático em data/yuri.db (não precisa desta variável)
# Vercel: Neon Postgres — Dashboard → Storage → Neon, depois:
# DATABASE_URL=postgres://...

# Imagens em produção (opcional, mas recomendado)
# BLOB_READ_WRITE_TOKEN=
